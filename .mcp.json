{
  "mcpServers": {
    "bicep": {
      "type": "stdio",
      "command": "dnx",
      "args": ["-y", "Azure.Bicep.McpServer"],
      "env": {}
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    }
  }
}
